# Copy to .env (git-ignored).
#
# docker compose reads ANTHROPIC_API_KEY from here (or from the shell), plus the optional
# LLM_PROVIDER, ANTHROPIC_MODEL, ANTHROPIC_EFFORT, ANTHROPIC_FALLBACKS, FAKE_LLM_DELAY_MS,
# WORKER_CONCURRENCY, COOKIE_SECURE and LOG_LEVEL; it sets DATABASE_URL and PORT itself.
# `npm run dev` reads every variable below.
PORT=4000
# Example local Postgres; adjust host/port to your setup.
DATABASE_URL=postgres://cvbuilder:cvbuilder@localhost:5433/cvbuilder

# The only secret. Leave empty to run without Claude (generation jobs fail with
# LLM_NOT_CONFIGURED), or set LLM_PROVIDER=fake for a keyless demo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (beta). Set to false if the API rejects it.
ANTHROPIC_FALLBACKS=true
# anthropic | fake
LLM_PROVIDER=anthropic
# Fake provider only: artificial delay per pipeline step, to watch the progress UI.
FAKE_LLM_DELAY_MS=1500

WORKER_ENABLED=true
WORKER_CONCURRENCY=2
# Set to true when served over HTTPS.
COOKIE_SECURE=false
# Express "trust proxy" setting; the default trusts private-network hops (the Next.js rewrite).
TRUST_PROXY=loopback, linklocal, uniquelocal
LOG_LEVEL=info
NODE_ENV=development
