# Copy to .env for `npm run dev`. docker compose provides these variables itself.
PORT=4000
# Example local Postgres; adjust host/port to your setup.
DATABASE_URL=postgres://cvbuilder:cvbuilder@localhost:5433/cvbuilder

# The only secret. Leave empty to run without Claude (generation jobs fail with
# LLM_NOT_CONFIGURED), or set LLM_PROVIDER=fake for a keyless demo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# anthropic | fake
LLM_PROVIDER=anthropic

WORKER_ENABLED=true
WORKER_CONCURRENCY=2
# Set to true when served over HTTPS.
COOKIE_SECURE=false
# Express "trust proxy" setting; the default trusts private-network hops (the Next.js rewrite).
TRUST_PROXY=loopback, linklocal, uniquelocal
LOG_LEVEL=info
NODE_ENV=development
