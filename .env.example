# cp .env.example .env — read by docker compose (env_file) and by npm run dev.
# For npm run dev outside Docker, override DATABASE_URL in .env.local.

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_FALLBACKS=true
# anthropic | fake (keyless demo)
LLM_PROVIDER=anthropic
FAKE_LLM_DELAY_MS=1500

# Database
POSTGRES_USER=cv
POSTGRES_PASSWORD=cv
POSTGRES_DB=cv
# Must match the POSTGRES_* values above.
DATABASE_URL=postgres://cv:cv@db:5432/cv

# API
PORT=4000
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
COOKIE_SECURE=false
# Keep false behind the Next.js rewrite (it passes the client's X-Forwarded-For through);
# set it to your edge proxy's address only if that proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
LOG_LEVEL=info

# Frontend image (docker compose)
WEB_CONTEXT=../ai-cv-builder-front
# Port must match PORT.
API_INTERNAL_URL=http://api:4000
