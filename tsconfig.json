{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,

    // TypeORM uses legacy decorators. Decorator metadata is intentionally NOT emitted:
    // tsx/vitest (esbuild) cannot emit it, so every column declares its type explicitly
    // and dev, test and prod builds behave identically.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "useDefineForClassFields": false,

    "noEmit": true
  },
  "include": ["src", "test", "scripts", "vitest.config.ts"]
}
